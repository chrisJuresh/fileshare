# >>> fileshare site (scripts/caddy/apply.sh; remove with scripts/caddy/revert.sh) >>>
# Variant B (default): site-local only, no change to the global options block.
# Public share site. The router forwards external 443 -> ${LAN_IP}:8443; nothing else reaches it.
${PUBLIC_HOST}:8443 {
	bind ${LAN_IP}

	tls {
		issuer acme {
			# Port 80 is not forwarded: TLS-ALPN-01 only, answered on this listener.
			disable_http_challenge
			alt_tlsalpn_port 8443
		}
	}

	# HTTP/3 can't work through the TCP-only 443->8443 forward, so don't advertise it.
	# Caddy sets Alt-Svc before handlers run, and again on its own error responses, so it is
	# stripped in both places (verified on Caddy 2.11.7).
	header -Alt-Svc
	header -Server
	header Strict-Transport-Security "max-age=31536000"

	# No uploads on the public site.
	request_body {
		max_size 64KB
	}

	# No access log on purpose: share URLs carry tokens.
	reverse_proxy ${PUBLIC_BIND}:${PUBLIC_PORT} {
		flush_interval -1
		stream_close_delay 5m
	}

	handle_errors {
		header -Alt-Svc
		header -Server
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
# <<< fileshare site <<<
