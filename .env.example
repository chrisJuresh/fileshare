# Copy to .env and adjust. Never commit .env. Secrets are NOT set here — they live in files under
# ${APPDATA}/secrets (see scripts/gen-secrets.sh and docs/RUNBOOK.md).

# --- Identity / time ---
PUID=1000
PGID=1000
TZ=Europe/London
LOG_LEVEL=info

# --- Hostnames (every URL the app emits is built from these, never from the request) ---
PUBLIC_BASE_URL=https://files.example.com
ADMIN_BASE_URL=https://files-admin.example.com
# Hostname the DDNS container keeps pointed at this network's public IPv4 (DNS-only record).
DDNS_DOMAINS=files.example.com

# --- Host paths ---
# Data root: outbox/, library/, staging/, uploads/ live here.
DATA_ROOT=/srv/fileshare-data
# App state, secrets and Syncthing config live under here.
APPDATA=/srv/appdata/fileshare
# restic repository (ideally on a different disk from DATA_ROOT).
RESTIC_REPO_HOST=/srv/fileshare-restic

# --- Listeners (app uses host networking) ---
# Public HTTP: only the local reverse proxy (Caddy) should reach this.
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8090
# Admin HTTP: bind to the address your tunnel connector can reach (e.g. the docker bridge
# gateway of the tunnel's network). Never 0.0.0.0.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8091
# BitTorrent TCP+uTP and WebRTC ICE (UDP mux). Forward both from the router 1:1.
BT_PORT=6890
WEBRTC_PORT=6891
# Optional: public IPv4 to inject as an ICE host candidate if STUN-derived candidates don't work.
WEBRTC_ANNOUNCE_IP=
STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
# Trust X-Forwarded-For from loopback (the reverse proxy). Needed for per-IP rate limits.
TRUST_PROXY=true

# --- Syncthing ---
# LAN address to publish the Syncthing sync port (22000) on.
LAN_IP=192.0.2.10
SYNCTHING_FOLDER_ID=fileshare-outbox
# Filled in by scripts/pair-pc.sh.
SYNCTHING_PC_DEVICE_ID=
INGEST_QUIET_SECONDS=120

# --- Cloudflare Access (admin) — not secrets ---
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# Optional extra allow-list on top of the Access policy (comma separated).
ADMIN_EMAILS=

# --- Snapshots ---
SNAPSHOT_DEBOUNCE_SECONDS=120
# Local time window in which no restic job runs (e.g. another nightly backup reads the disk).
SNAPSHOT_PAUSE_WINDOW=03:45-05:15
